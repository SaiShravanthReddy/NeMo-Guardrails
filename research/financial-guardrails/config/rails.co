define bot financial policy refusal
  "I cannot provide that content under this application's security policy."

define bot financial check unavailable
  "The security check is unavailable. Please try again later."

define bot financial confirmation required
  "This action requires confirmation from a trusted application control."

define subflow financial check input
  $verdict = execute screen_financial_text(text=$user_message, direction="input")
  if $verdict == "block"
    bot financial policy refusal
    stop
  if $verdict == "require_confirmation"
    bot financial confirmation required
    stop

define subflow financial check output
  $verdict = execute screen_financial_text(text=$bot_message, direction="output")
  if $verdict == "block"
    bot financial policy refusal
    stop
  if $verdict == "require_confirmation"
    bot financial confirmation required
    stop

define subflow financial check retrieval
  $verdict = execute screen_financial_text(text=$relevant_chunks, direction="retrieval")
  if $verdict == "block"
    bot financial policy refusal
    stop
  if $verdict == "require_confirmation"
    bot financial confirmation required
    stop
